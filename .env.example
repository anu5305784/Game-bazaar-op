# ====================================================================
# GAMER BAZAAR — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# IMPORTANT: Never commit actual passwords, private keys, or credentials.
# ====================================================================

# 1. Server Environment
NODE_ENV=production
PORT=8080

# 2. Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://gamerbazaar_user:YOUR_POSTGRES_PASSWORD@dpg-your-db-id.render.com/gamerbazaar?sslmode=require

# 3. Security & Administrator Bootstrap
# Required to initialize or elevate the primary platform administrator
# Never share this key publicly.
ADMIN_SETUP_KEY=GB-ADMIN-SECURE-KEY-2026
JWT_SECRET=YOUR_HIGH_ENTROPY_JWT_SECRET_MIN_32_CHARS

# 4. Indian Payments Gateway (UPI)
# Registered merchant Virtual Payment Address (VPA) for manual & automated reconciliation
UPI_MERCHANT_VPA=gamerbazaar.escrow@icici
UPI_MERCHANT_NAME=Gamer Bazaar Escrow Services

# 5. Crypto Payment Gateway (NOWPayments / Coinbase Commerce)
# Keep disabled or blank until merchant verification is completed
CRYPTO_PROVIDER_ENABLED=false
CRYPTO_PROVIDER_API_KEY=YOUR_CRYPTO_MERCHANT_API_KEY
CRYPTO_WEBHOOK_SECRET=YOUR_CRYPTO_WEBHOOK_HMAC_SECRET

# 6. AI Studio / Gemini API (Optional)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
